# Generate once: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=
DB_PATH=data/bayproject.db
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
# Choose available models in your provider dashboard. Original bot defaults below.
AI_TEXT_MODEL=openai/gpt-oss-120b
AI_VISION_MODEL=qwen/qwen3.6-27b
# Leave empty unless your selected model explicitly supports it.
AI_REASONING_EFFORT=
TWELVE_DATA_API_KEY=
TAVILY_API_KEY=
ENABLE_WORKER=true
# Optional Expo push access token when enhanced push security is enabled.
EXPO_ACCESS_TOKEN=
# For 9Router: AI_BASE_URL=https://your-private-router.example/v1
